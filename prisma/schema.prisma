// Prisma schema for the aggregator service.
// NOTE: This file is intentionally compact; extend models as features land.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Token {
  id        String   @id @default(cuid())
  symbol    String   @unique
  address   String   @unique
  decimals  Int
  chainId   Int
  isStable  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Per-token-pair oracle bound overrides where this token is the source.
  pairOverridesAsSrc OraclePairOverride[] @relation("PairOverrideSrc")
  // Per-token-pair oracle bound overrides where this token is the destination.
  pairOverridesAsDst OraclePairOverride[] @relation("PairOverrideDst")

  @@index([chainId])
}

// Operator-configured per-token-pair overrides for oracle slippage/premium
// bounds. A row may set either or both bounds; any unset (null) bound falls
// back to the global OracleMinDstConfig default at resolution time.
model OraclePairOverride {
  id                String   @id @default(cuid())
  srcTokenId        String
  dstTokenId        String
  maxUserSlippageBps BigInt?
  maxPremiumBps     BigInt?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  srcToken Token @relation("PairOverrideSrc", fields: [srcTokenId], references: [id], onDelete: Cascade)
  dstToken Token @relation("PairOverrideDst", fields: [dstTokenId], references: [id], onDelete: Cascade)

  @@unique([srcTokenId, dstTokenId])
  @@index([srcTokenId])
  @@index([dstTokenId])
}

// A cross-chain swap intent. The `locked*` fields pin the exact oracle
// fair-value snapshot that `validateMinDstAmount()` validated against at
// creation time, so later reconciliation/audit can compare against the price
// the user actually agreed to rather than a newer live snapshot.
model Intent {
  id        String   @id @default(cuid())
  srcTokenId String
  dstTokenId String
  srcAmount  String
  minDstAmount String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Locked fair-value snapshot from the successful MinDstValidationOk result.
  // `lockedFairValue` is null when the oracle was unavailable (fail-open),
  // which is distinguishable from a computed fair value of zero.
  lockedFairValue    String?
  lockedSlippageBps  BigInt?
  lockedPremiumBps   BigInt?
  lockedAsOfMs       BigInt?

  @@index([srcTokenId])
  @@index([dstTokenId])
}
